<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>gov.nist.healthcare.iz</groupId>
	<artifactId>darq</artifactId>
	<version>3.1.4.3</version>
	<packaging>pom</packaging>
	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
		<!-- Jakarta JAXB stack, pinned to the 3.0.x line: codebase-client 3.0.0 uses the
		     jakarta.xml.bind namespace, but its default API (4.0.2) and runtime are compiled
		     for Java 11 (class major 55) and will not load on this project's Java 8 target.
		     The 3.0.x artifacts are the same namespace built for Java 8 (major 52).  Temporary fix until maybe an upgrade to java 11
		     Note: jakarta.activation-api has its own version line and never had a 4.x release -
		     2.0.x pairs with JAXB 3.0.x (2.1.x pairs with JAXB 4.0.x). -->
		<jakarta.xml.bind.version>3.0.1</jakarta.xml.bind.version>
		<jakarta.activation.version>2.0.1</jakarta.activation.version>
		<jaxb.runtime.version>3.0.2</jaxb.runtime.version>
		<!-- Legacy javax.xml.bind stack. No qDAR code uses it - it is declared at runtime scope
		     only because org.immregistries:mqe-hl7-utility calls javax.xml.bind.JAXBContext /
		     Unmarshaller without declaring a dependency of its own. On Java 8 the JDK supplies
		     javax.xml.bind from rt.jar so this is currently redundant, but it disappears from the
		     JDK on Java 11+, where MQE would fail with NoClassDefFoundError without these.
		     2.3.1 is the final javax release (api major 52, impl major 51 - both Java 8 safe). -->
		<javax.xml.bind.version>2.3.1</javax.xml.bind.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>jakarta.xml.bind</groupId>
				<artifactId>jakarta.xml.bind-api</artifactId>
				<version>${jakarta.xml.bind.version}</version>
			</dependency>
			<dependency>
				<groupId>jakarta.activation</groupId>
				<artifactId>jakarta.activation-api</artifactId>
				<version>${jakarta.activation.version}</version>
			</dependency>
			<dependency>
				<groupId>org.glassfish.jaxb</groupId>
				<artifactId>jaxb-runtime</artifactId>
				<version>${jaxb.runtime.version}</version>
			</dependency>
			<dependency>
				<groupId>javax.xml.bind</groupId>
				<artifactId>jaxb-api</artifactId>
				<version>${javax.xml.bind.version}</version>
			</dependency>
			<dependency>
				<groupId>com.sun.xml.bind</groupId>
				<artifactId>jaxb-impl</artifactId>
				<version>${javax.xml.bind.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<modules>
		<module>file-parser</module>
		<module>darq-webapp</module>
		<module>darq-common</module>
		<module>darq-aart-client</module>
		<module>darq-extract-process</module>
		<module>darq-analyzer</module>
        <module>lucene-index</module>
        <module>fake-record-generator</module>
        <module>crypto-helper</module>
		<module>spring-auth</module>
        <module>darq-shared</module>
        <module>darq-adf-merge-cli</module>
        <module>darq-patient-matching</module>
        <module>test-commons</module>
    </modules>
</project>