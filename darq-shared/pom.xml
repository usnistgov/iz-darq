<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>darq</artifactId>
        <groupId>gov.nist.healthcare.iz</groupId>
        <version>3.1.4.3</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>darq-shared</artifactId>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mqe.version>2026.8-BETA</mqe.version>
        <qdar.api.version>3.1.4.3</qdar.api.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>gov.nist.healthcare.iz</groupId>
            <artifactId>darq-adf-utils</artifactId>
            <version>${qdar.api.version}</version>
        </dependency>
        <dependency>
            <groupId>org.immregistries</groupId>
            <artifactId>mqe-validator</artifactId>
            <version>${mqe.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <!-- lonestar drags in jaxb-core 2.2.11, which shares 102 duplicate classes with
                     the jaxb-impl 2.3.1 pinned below and would shadow it depending on classpath
                     order. jaxb-core has no 2.3.1 release to align on, and jaxb-impl 2.3.1 already
                     bundles com.sun.xml.bind.v2.*; the com.sun.istack / com.sun.xml.txw2 classes
                     it does not bundle come from txw2 + istack-commons-runtime, already on the
                     classpath via the jakarta jaxb-runtime. -->
                <exclusion>
                    <groupId>com.sun.xml.bind</groupId>
                    <artifactId>jaxb-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- codebase-client (via mqe-validator) only brings the jakarta.xml.bind *API*.
             Without an implementation on the classpath, JAXBContext.newInstance fails at
             runtime with "Implementation of Jakarta XML Binding-API has not been found"
             (ClassNotFoundException: org.glassfish.jaxb.runtime.v2.ContextFactory). -->
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Legacy javax.xml.bind, for mqe-hl7-utility only (it calls javax.xml.bind.JAXBContext
             and Unmarshaller but declares no dependency for them). Deliberately *runtime* scope:
             qDAR code compiles against jakarta.xml.bind only, and runtime scope makes it
             impossible to import javax.xml.bind here by accident. Redundant on Java 8, where the
             JDK still supplies javax.xml.bind; required on Java 11+, where it does not.
             Versions come from the root pom's dependencyManagement. -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.sun.xml.bind</groupId>
            <artifactId>jaxb-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>gov.nist.healthcare.iz</groupId>
            <artifactId>darq-patient-matching</artifactId>
            <version>${qdar.api.version}</version>
        </dependency>
        <dependency>
            <groupId>gov.nist.healthcare.iz</groupId>
            <artifactId>darq-digest-model</artifactId>
            <version>${qdar.api.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.12.0</version>
        </dependency>
        <dependency>
            <groupId>gov.nist.healthcare.iz</groupId>
            <artifactId>file-parser</artifactId>
            <version>${qdar.api.version}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>
</project>